# --- Database (PostgreSQL) ---
# App connection. In production use a POOLED url (e.g. the Neon pooler).
DATABASE_URL="postgresql://user:password@localhost:5432/amana?schema=public"
# Direct (unpooled) connection used for `prisma migrate`. Locally it can equal
# DATABASE_URL; on Neon use the non-pooled host.
DIRECT_URL="postgresql://user:password@localhost:5432/amana?schema=public"

# --- Site ---
# Public origin, used for sitemap.xml / robots.txt / canonical URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth ---
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# --- SMS (OTP delivery) ---
# "console" (default — prints the code to the server log) or "http" (real gateway).
SMS_PROVIDER="console"
# Required only when SMS_PROVIDER=http:
SMS_HTTP_ENDPOINT=""
SMS_HTTP_API_KEY=""
SMS_HTTP_SENDER="Amana"
