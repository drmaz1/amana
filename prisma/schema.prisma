// Amana Platform — MVP schema
// Inter-governorate seat booking + parcel transport (Iraq)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection for the app
  directUrl = env("DIRECT_URL") // unpooled connection for migrations
}

// ---------- Enums ----------

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum VehicleType {
  SEDAN // صالون (1 أمام + 3 خلف = 4 ركاب)
  SUV // دفع رباعي (1 + 2 + 3 = 6 ركاب)
  GMC // (1 + 3 + 3 = 7 ركاب)
}

enum TripStatus {
  SCHEDULED // مجدولة
  ONGOING // جارية
  COMPLETED // مكتملة
  CANCELLED // ملغاة
}

enum BookingStatus {
  PENDING // بانتظار التأكيد
  CONFIRMED // مؤكد
  CANCELLED // ملغى
  COMPLETED // منجز
}

enum ParcelStatus {
  REQUESTED // طلب جديد
  ACCEPTED // مقبول من سائق
  IN_TRANSIT // قيد النقل
  DELIVERED // مُسلّم
  CANCELLED // ملغى
}

// ---------- Models ----------

model User {
  id          String    @id @default(cuid())
  name        String
  phone       String    @unique
  role        Role      @default(PASSENGER)
  // Driver reputation (display-only; null/0 for passengers and new drivers).
  rating      Float?
  tripsCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  // relations
  vehicles    Vehicle[]
  driverTrips Trip[]    @relation("DriverTrips")
  bookings    Booking[] @relation("PassengerBookings")
  parcelsSent Parcel[]  @relation("ParcelSender")
  reviewsReceived Review[] @relation("DriverReviews")
  reviewsWritten  Review[] @relation("PassengerReviews")

  @@index([role])
}

model Vehicle {
  id       String      @id @default(cuid())
  driver   User        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String
  type     VehicleType @default(SEDAN)
  model    String // e.g. "Toyota Avalon 2018"
  plate    String      @unique
  seats    Int         @default(4) // passenger seats (excludes driver)
  trips    Trip[]

  @@index([driverId])
}

model Trip {
  id             String     @id @default(cuid())
  driver         User       @relation("DriverTrips", fields: [driverId], references: [id])
  driverId       String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id])
  vehicleId      String
  originId       String // governorate code, e.g. "baghdad"
  destinationId  String // governorate code, e.g. "basra"
  departureAt    DateTime
  durationMinutes Int? // estimated travel time, shown on trip/seat cards
  pricePerSeat   Int // IQD — lowest seat price ("starts from")
  seatPrices     Int[]   @default([]) // IQD per seat, index 0 = seat 1
  totalSeats     Int
  status         TripStatus @default(SCHEDULED)
  acceptsParcels Boolean    @default(true)
  parcelBasePrice Int? // IQD, base price for a small parcel
  notes          String?
  createdAt      DateTime   @default(now())
  // relations
  bookings       Booking[]
  bookingSeats   BookingSeat[]
  parcels        Parcel[]
  reviews        Review[]

  @@index([originId, destinationId, departureAt])
  @@index([driverId])
  @@index([status])
}

model Booking {
  id          String        @id @default(cuid())
  reference   String        @unique // human-friendly ref shown to the passenger
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  passenger   User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  passengerId String
  seatNumbers Int[] // denormalized display copy; BookingSeat is source of truth
  totalPrice  Int // IQD
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  // relations
  bookingSeats BookingSeat[]
  review       Review?

  @@index([tripId])
  @@index([passengerId])
}

/// A passenger's rating of the driver for a completed booking. One per booking
/// (bookingId @unique). Creating one recomputes the driver's average `rating`.
model Review {
  id          String   @id @default(cuid())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String   @unique
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  driver      User     @relation("DriverReviews", fields: [driverId], references: [id])
  driverId    String
  passenger   User     @relation("PassengerReviews", fields: [passengerId], references: [id])
  passengerId String
  rating      Int // 1..5
  comment     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([tripId])
}

/// One row per held seat on a trip. The DB-level @@unique([tripId, seatNumber])
/// makes double-booking impossible; booking creation runs in a transaction and
/// a unique-constraint violation surfaces as a typed "seat taken" error.
/// Cancelling a booking deletes its BookingSeat rows, freeing the seats.
model BookingSeat {
  id         String  @id @default(cuid())
  trip       Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId     String
  seatNumber Int
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String

  @@unique([tripId, seatNumber])
  @@index([tripId])
  @@index([bookingId])
}

/// Phone OTP codes for passwordless auth. Codes are hashed, expire after a few
/// minutes, and cap verification attempts.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Parcel {
  id            String       @id @default(cuid())
  reference     String       @unique // human-friendly ref shown to the sender
  trip          Trip?        @relation(fields: [tripId], references: [id])
  tripId        String?
  // Sender links to a User when authenticated; otherwise `senderName` holds the
  // guest's free-text name (the parcel form collects no sender phone).
  sender        User?        @relation("ParcelSender", fields: [senderId], references: [id])
  senderId      String?
  senderName    String?
  originId      String
  destinationId String
  receiverName  String
  receiverPhone String
  description   String
  weightKg      Float?
  price         Int // IQD
  status        ParcelStatus @default(REQUESTED)
  createdAt     DateTime     @default(now())

  @@index([originId, destinationId])
  @@index([status])
}
